# Optional. OAI Bot finds `codex` on PATH on macOS, Linux, and Windows.
# On macOS it also checks the Codex runtime bundled with ChatGPT.app.
# CODEX_BIN=/absolute/path/to/codex

# Local-only defaults. Set HOST=0.0.0.0 only on a trusted private network.
# HOST=127.0.0.1
# PORT=4317

# Optional shared-computer Docker runtime limits. When the Docker provider is
# enabled, startup is atomic: the computer and its Codex exec-server must become
# healthy before OAI Bot accepts agent work.
# OAI_RUNTIME_MEMORY_LIMIT=8g
# OAI_RUNTIME_CPU_LIMIT=4.0
# OAI_RUNTIME_PIDS_LIMIT=4096
# OAI_RUNTIME_SHM_SIZE=1gb
# OAI_RUNTIME_NOVNC_PORT=6080
# OAI_RUNTIME_EXEC_PORT=4096
# OAI_RUNTIME_REQUIRE_EGRESS=false
# OAI_RUNTIME_PROVIDER=docker
# Keep this aligned with the host Codex App Server protocol version.
# OAI_CODEX_VERSION=0.151.0
# Set these to the host service user's IDs when using bind mounts (`id -u`, `id -g`).
# OAI_RUNTIME_UID=1000
# OAI_RUNTIME_GID=1000
# OAI_RUNTIME_WORKSPACE_PATH=/absolute/path/to/shared-workspace
# OAI_RUNTIME_AGENT_WORKSPACES_PATH=/absolute/path/to/agent-workspaces
# OAI_RUNTIME_USER_STATE_PATH=/absolute/path/to/runtime-state
