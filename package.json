{
  "name": "oai-bot",
  "version": "0.2.0",
  "private": true,
  "description": "An unofficial, community-built multi-agent workspace powered by Codex and a ChatGPT subscription.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikezio/oai-bot.git"
  },
  "bugs": {
    "url": "https://github.com/mikezio/oai-bot/issues"
  },
  "homepage": "https://github.com/mikezio/oai-bot#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "server/",
    "scripts/doctor.ts",
    ".env.example",
    "start.command"
  ],
  "type": "module",
  "scripts": {
    "check": "npm test && npm run build",
    "dev": "concurrently -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "doctor": "tsx scripts/doctor.ts",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-tests.ts",
    "start": "tsx server/index.ts --production"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "better-sqlite3@12.10.1": true
  }
}
